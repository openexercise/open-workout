{
  "name": "@openexercise/open-workout-client",
  "version": "0.6.0",
  "description": "A thin TypeScript client for any Open Workout or Open Food Log server, generated from their API cores, with Lifterclub's full API as a subpath.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openexercise/open-workout.git",
    "directory": "clients/ts"
  },
  "homepage": "https://github.com/openexercise/open-workout/tree/main/clients/ts#readme",
  "bugs": "https://github.com/openexercise/open-workout/issues",
  "keywords": [
    "open-workout",
    "open-workout-schema",
    "open-exercise",
    "open-food-log",
    "lifterclub",
    "workout",
    "fitness",
    "openapi"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openfoodlog": {
      "types": "./dist/openfoodlog.d.ts",
      "import": "./dist/openfoodlog.js"
    },
    "./lifterclub": {
      "types": "./dist/lifterclub.d.ts",
      "import": "./dist/lifterclub.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "check": "node scripts/gen.mjs && git diff --exit-code -- src/core.d.ts src/ofl-core.d.ts src/lifterclub-api.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && cp src/core.d.ts src/ofl-core.d.ts src/lifterclub-api.d.ts dist/",
    "prepack": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
